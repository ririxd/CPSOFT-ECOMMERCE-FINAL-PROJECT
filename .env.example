# Copy to .env for local configuration. Never commit real secrets.
APP_ENV=development
PORT=8000
APP_ORIGIN=http://localhost:8000
DB_PATH=data/auth.sqlite

# Supabase: use the Session pooler URI or direct connection URI from Project > Connect.
# Keep the password URL-encoded. Production requires DATABASE_URL.
DATABASE_URL=
PGSSLMODE=require

# Generate at least 32 random characters (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET=

# Brevo API key and a verified sender configured in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Art House
