# Local development
APP_ENV=development
PORT=8000
APP_ORIGIN=http://localhost:8000
DB_PATH=data/auth.sqlite

# Supabase: use the Session pooler URI or direct connection URI from Project > Connect.
# Keep the password URL-encoded. Production requires DATABASE_URL.
DATABASE_URL=
PGSSLMODE=require

# Generate at least 32 random characters.
APP_SECRET=

# Brevo SMTP relay (SMTP credentials, not an API key)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Art House
